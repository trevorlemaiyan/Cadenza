# Spotify Developer Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Must match exactly what you set in your Spotify app's Redirect URIs
REDIRECT_URI=http://localhost:5000/callback

# Any long random string — used to sign Flask sessions
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_secret_key

# PostgreSQL connection string (primary database)
# Local:   postgresql://user:password@localhost:5432/cadenza
# Railway: paste the DATABASE_URL from your Railway PostgreSQL service
DATABASE_URL=postgresql://user:password@localhost:5432/cadenza

# Redis URL (optional — enables distributed caching)
# Local:   redis://localhost:6379/0
# Railway/Upstash: paste your REDIS_URL here
REDIS_URL=redis://localhost:6379/0

# MongoDB connection string (optional — legacy / dual-write mode)
# Leave blank to run PostgreSQL-only
MONGO_URI=
