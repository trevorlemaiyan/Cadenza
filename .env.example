# =============================================================================
# Cadenza — local development environment
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ─── Flask ───────────────────────────────────────────────────────────────────
# Generate a strong key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-secrets-token-hex-32

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# docker-compose default — works out-of-the-box when running `docker compose up`
DATABASE_URL=postgresql://cadenza:cadenza@db:5432/cadenza

# Local Postgres (if running Postgres directly on your machine, not in Docker):
# DATABASE_URL=postgresql://cadenza:cadenza@localhost:5432/cadenza

# ─── Redis ───────────────────────────────────────────────────────────────────
# docker-compose default — works out-of-the-box when running `docker compose up`
REDIS_URL=redis://redis:6379/0

# Local Redis (if running Redis directly):
# REDIS_URL=redis://localhost:6379/0

# ─── Spotify API credentials ─────────────────────────────────────────────────
# The app works without these (login/OAuth will be unavailable but the
# recommendation engine and /health endpoint will function normally).
# Get credentials from: https://developer.spotify.com/dashboard
#
# 1. Create an app at the dashboard.
# 2. Add  http://localhost:5000/callback  to Redirect URIs.
# 3. Paste your Client ID and Client Secret below.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
REDIRECT_URI=http://localhost:5000/callback

# ─── Optional: MongoDB legacy dual-write ─────────────────────────────────────
# Leave blank to run PostgreSQL-only (recommended).
MONGO_URI=
